{
  "name": "llm-provider-server",
  "version": "1.0.0",
  "description": "Orchestrator for free AI providers",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "cd client && npm run build && cd .. && node server.js",
    "build": "node scripts/build.js",
    "test": "node src/testResultsCli.js",
    "chat": "node src/chatTui.js",
    "fresh-db": "rm -rf status.db",
    "test:view": "node src/testResultsServer.js",
    "test:raw": "node src/testRunner.js"
  },
  "pkg": {
    "assets": [
      "client/dist/**/*",
      "node_modules/better-sqlite3/build/**/*",
      "node_modules/blessed/usr/**/*"
    ],
    "targets": [
      "node22-linux-x64"
    ],
    "publicPackages": [
      "blessed",
      "blessed-contrib"
    ]
  },
  "keywords": [
    "llm",
    "ai",
    "orchestrator",
    "free-tier"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gpt-tokenizer": "^3.4.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "winston": "^3.11.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.1"
  }
}
