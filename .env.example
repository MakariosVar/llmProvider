# LLM Provider Server Configuration
#
# Copy to .env and fill in the keys you have. Every provider is optional —
# leave a key blank and that provider is simply skipped during routing.
# You need at least one working provider (or a local Ollama) to get responses.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000

# Credentials for the dashboard's Settings page.
# !! CHANGE THE PASSWORD BEFORE EXPOSING THIS SERVER ANYWHERE !!
# GET /api/settings returns every key in this file in plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Comma-separated CORS origins for Socket.io. Defaults to * (open) — narrow this
# if you put the server behind a proxy.
# ALLOWED_ORIGINS=http://localhost:5173

# Request size ceilings, in tokens.
# MAX_PROMPT_TOKENS=30000
# MAX_SYSTEM_TOKENS=5000

# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------

# Speech-to-text (Whisper) is served by Groq and requires this key.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
KILOCODE_API_KEY=your_kilocode_api_key_here
ZAI_API_KEY=your_zai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# A GitHub PAT with access to the Models catalog.
GITHUB_TOKEN=your_github_personal_access_token_here
COHERE_API_KEY=your_cohere_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NOVITA_API_KEY=your_novita_api_key_here

# Cloudflare needs BOTH values (text + image).
CLOUDFLARE_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Not currently used — these providers are commented out in src/config.js.
# Kept here because the Settings page still lists them.
# Cerebras: re-enable the provider block in src/config.js.
CEREBRAS_API_KEY=your_cerebras_api_key_here
# HuggingFace: ended its free inference API.
HF_API_KEY=your_huggingface_api_key_here

# No key needed for OVHcloud or Pollinations.ai.

# ---------------------------------------------------------------------------
# Local models
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434